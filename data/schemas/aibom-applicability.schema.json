{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/GenAI-Security-Project/crosswalk/blob/main/data/schemas/aibom-applicability.schema.json",
  "title": "OWASP GenAI Crosswalk — AIBOM applicability profiles",
  "description": "The format of data/aibom-applicability.json (T-AIBOM01). A profile adds whole source lists as candidate risks; it never selects a single entry. See docs/AIBOM_INTEGRATION.md.",
  "type": "object",
  "required": ["format_version", "status", "profiles", "default_frameworks"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "format_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "pattern": "^DRAFT\\b|^Reviewed\\b", "description": "DRAFT until an SME signs the profiles off." },
    "status_note": { "type": "string" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "default_for_tasks", "source_lists"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "default_for_tasks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "source_lists": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "default_frameworks": {
      "type": "object",
      "required": ["framework_ids"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "framework_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
