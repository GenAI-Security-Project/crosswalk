{
  // Markdown lint configuration for the OWASP GenAI Crosswalk.
  //
  // The crosswalk is a set of dense reference documents built around wide
  // mapping tables and a repeated per-entry structure. A few default rules
  // fight that format rather than catching real defects; those are relaxed
  // below with the reason. Everything else is enforced.

  "globs": ["**/*.md"],

  "ignores": [
    "node_modules",
    "reports",   // generated by `npm run build:reports`
    "dist"       // generated by `npm run compile`
  ],

  "config": {
    // Mapping tables carry a control id, name, tier, scope, and a full
    // sentence of implementation guidance per row, so they are wide by
    // design and cannot be wrapped without breaking the table. Prose and
    // headings are still held to a limit.
    "MD013": {
      "line_length": 120,
      "tables": false,
      "code_blocks": false,
      "headings": false
    },

    // Every file repeats the same subsection headings once per entry
    // (`#### Tools`, `#### Cross-references`, ...). They are unique within
    // their parent entry, which is what `siblings_only` checks.
    "MD024": { "siblings_only": true },

    // `**Foundational**` / `**Hardening**` / `**Advanced**` are the
    // crosswalk's maturity-tier labels. They are deliberately emphasis and
    // not headings: promoting them would put 30 entries per file into the
    // document outline and bury the actual structure.
    "MD036": false,

    // Every mapping file opens with an HTML comment banner recording the
    // source list, framework, version, and licence, before the H1.
    "MD041": false
  }
}
